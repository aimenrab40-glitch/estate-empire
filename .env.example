# Copy to .env (or export in your shell) — every value has a sane default for local dev.

# ---- server ----
# PORT=4000
# NODE_ENV=development

# ---- database (pick ONE strategy) ----
# 1) Neon / any managed Postgres (production):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/estate?sslmode=require
# 2) Local Postgres:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=estate
# 3) Nothing reachable -> the server boots the bundled PostgreSQL on port 5433
#    with its data directory in ./.pgdata. Disable it with EMBEDDED_PG=0.
# EMBEDDED_PG=0
# Require a reachable DB or fail at boot (implicit when DATABASE_URL or PGHOST is set):
# REQUIRE_DB=1
# Explicit opt-out of persistence (local hacking only, never production):
# NO_DB=1

# ---- public origin (deployment) ----
# Set to the public URL of the deployed service, e.g.
# https://super-nova-mafia.onrender.com
# Used to build OAuth redirect URIs when the Host header differs (proxies).
# PUBLIC_ORIGIN=

# ---- OAuth (optional — guests always play; sign-in is an optional upgrade) ----
# Google (https://console.cloud.google.com/apis/credentials):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/auth/google/callback
# Discord (https://discord.com/developers/applications):
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://YOUR-DOMAIN/auth/discord/callback
# DISCORD_GUILD_ID=
# NO_AUTH=1   (local dev only — never in production)

# ---- client (Vite, build-time) ----
# Optional TURN server for remote voice chat on restrictive NATs:
# VITE_TURN_URL=turn:your-turn.example.com:3478
# VITE_TURN_USER=username
# VITE_TURN_PASS=password
